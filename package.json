{
  "name": "projector-client",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "accounting": "^0.4.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-number-format": "^5.4.3",
    "react-router-dom": "^5.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.1.3"
  },
  "scripts": {
    "start": "npm run dev",
    "dev": "vite --host 0.0.0.0 --port 3000 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000 --strictPort",
    "predeploy": "npm run build",
    "deploy": "now ./build",
    "postdeploy": "now alias -A ./build/now.json"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
